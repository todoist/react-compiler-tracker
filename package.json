{
  "name": "@todoist/react-compiler-tracker",
  "version": "3.0.6",
  "description": "A React Compiler violation tracker to help migrations and prevent regressions",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "react-compiler-tracker": "dist/index.js"
  },
  "scripts": {
    "check": "run-p check:* -c -l",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint",
    "check:types": "tsc --noEmit",
    "fix": "run-s fix:lint fix:format",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix",
    "build": "run-s clean:* build:package",
    "postbuild": "publint",
    "build:package": "tsdown",
    "clean": "run-s clean:*",
    "clean:dist": "rimraf dist/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/todoist/react-compiler-tracker.git"
  },
  "keywords": [
    "react",
    "react-compiler",
    "memoization",
    "performance"
  ],
  "author": "Doist Developers <dev@doist.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/todoist/react-compiler-tracker/issues"
  },
  "homepage": "https://github.com/todoist/react-compiler-tracker#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">= 26.13.0",
      "onFail": "error"
    }
  },
  "files": [
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "dist/**"
  ],
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@todoist/tsconfig": "2.0.2",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.6.6",
    "babel-plugin-react-compiler": "1.0.0",
    "lefthook": "2.2.2",
    "npm-run-all2": "9.0.4",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "publint": "0.3.25",
    "rimraf": "6.1.4",
    "semantic-release": "26.0.1",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-react": "^7.0.0",
    "@babel/preset-typescript": "^7.0.0",
    "babel-plugin-react-compiler": "^1.0.0"
  },
  "dependencies": {
    "glob": "14.0.6",
    "minimatch": "11.0.8"
  }
}
